# Public build-time configuration. Never put server secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_JBCENTER_URL=https://juicebox.center
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz
# Enable only with reviewed Center deployment pins and an activated Homerun callback.
NEXT_PUBLIC_CENTER_WALLET_ENABLED=false
NEXT_PUBLIC_CENTER_WALLET_ISSUER=https://my.juicebox.center
NEXT_PUBLIC_CENTER_WALLET_AUDIENCE=https://juicebox.center
NEXT_PUBLIC_CENTER_WALLET_MANIFEST_ID=
NEXT_PUBLIC_CENTER_WALLET_MANIFEST_REVISION=
# EntryPoint prefund ceiling in wei; excludes separate Base data fees.
NEXT_PUBLIC_CENTER_WALLET_MAXIMUM_NETWORK_FEE_WEI=
# Same public WalletConnect project as juicebox.money.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=c3cac68dfb2309cc810db46671c9aad5

# Contract deployment (see DEPLOYMENT.md). Alternatively export HOMERUN_ENV_FILE=../../deploy-all-v6/.env.
# RPC_ETHEREUM_MAINNET=
# RPC_OPTIMISM_MAINNET=
# RPC_BASE_MAINNET=
# RPC_ARBITRUM_MAINNET=
# RPC_ETHEREUM_SEPOLIA=
# RPC_OPTIMISM_SEPOLIA=
# RPC_BASE_SEPOLIA=
# RPC_ARBITRUM_SEPOLIA=
# Existing Sphinx organization credentials (proposals only).
# SPHINX_MANAGED_BASE_URL=
# SPHINX_ORG_ID=
# SPHINX_API_KEY=
# Optional: the workspace holding the sibling protocol checkouts and their deployments/ trees.
# HOMERUN_WORKSPACE_PATH=../..
