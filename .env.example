# Public build-time configuration. Never put server secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_JBCENTER_URL=https://juicebox.center
NEXT_PUBLIC_BENDYSTRAW_URL=https://bendystraw.up.railway.app
NEXT_PUBLIC_TESTNET_BENDYSTRAW_URL=https://testnet.bendystraw.xyz
# Same public Para application as juicebox.money.
NEXT_PUBLIC_PARA_API_KEY=placeholder
NEXT_PUBLIC_PARA_ENV=BETA
# Match juicebox.money's runtime default; must be enabled in the Para dashboard.
NEXT_PUBLIC_PARA_ONRAMP_PROVIDER=MOONPAY
# Same public WalletConnect project as juicebox.money.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=c3cac68dfb2309cc810db46671c9aad5
