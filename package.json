{
  "name": "homerun",
  "homepage": "https://homerun.money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Homerun asset funding and income, built on Juicebox V6.",
  "engines": {
    "node": ">=24.1.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3010",
    "build": "node scripts/stage-public.mjs && next build --webpack",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser-flow.mjs",
    "test:create": "node test/create-browser.mjs",
    "test:a11y": "node test/accessibility.mjs",
    "test:contracts": "node scripts/test-contracts.mjs",
    "check": "npm run lint && npm run check:indexer && npm test && npm run test:live && npm run build && npm run test:contracts",
    "check:indexer": "node scripts/check-bendystraw-schema.mjs 7 --offline",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test:live": "vitest run",
    "lint": "eslint src scripts --max-warnings=0",
    "dev:prototype": "node scripts/serve.mjs",
    "build:prototype": "node scripts/build.mjs"
  },
  "dependencies": {
    "@bananapus/nana-sdk-core": "^2.3.2",
    "@coinbase/wallet-sdk": "4.3.7",
    "@getpara/react-component-library": "3.15.0",
    "@getpara/react-sdk-lite": "3.15.0",
    "@getpara/wagmi-v2-connector": "3.15.0",
    "@getpara/web-sdk": "3.15.0",
    "@safe-global/safe-apps-provider": "0.18.6",
    "@safe-global/safe-apps-sdk": "9.1.0",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/core": "3.6.4",
    "@walletconnect/ethereum-provider": "2.23.10",
    "dompurify": "3.4.14",
    "marked": "18.0.10",
    "next": "16.3.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "2.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "10.7.0",
    "eslint-config-next": "16.3.3",
    "graphql": "17.0.2",
    "jsdom": "29.1.1",
    "knip": "6.29.0",
    "postcss": "8.5.26",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    },
    "axios": "1.18.1",
    "bn.js@4": "4.12.5",
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "ws": "8.21.1"
  },
  "allowScripts": {
    "@reown/appkit": false,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "unrs-resolver@1.12.2": true
  }
}
